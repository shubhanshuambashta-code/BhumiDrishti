# Environment variables for BhumiDrishti
# Copy this file to .env and fill in your values

# ─── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=bhumidrishti
POSTGRES_USER=bhumidrishti
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://bhumidrishti:change_me_in_production@localhost:5432/bhumidrishti

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ─── Security ─────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
# JWT_SECRET=change_me_in_production_use_strong_random_key

# ─── Data Paths ───────────────────────────────────────────────────────────────
DATA_PATH=../data

# ─── Frontend ─────────────────────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:3001/api
REACT_APP_FALLBACK_MODE=false
